# Base URL of the WEB ecommerce backend (forever-full-stack/backend), default PORT 4000.
# Use your PC's LAN IP so the phone (Expo Go) can reach it. Phone + PC on same WiFi.
# Find it with `ipconfig` (Windows) -> IPv4 Address. Restart Expo after changing (npx expo start -c).
# IMPORTANT: do NOT include a trailing /api here. Endpoints already include /api/... in code.
# EXPO_PUBLIC_API_URL=http://192.168.128.61:4000
EXPO_PUBLIC_API_URL=https://ecommerce-backend-expressjs-code-complete.onrender.com
